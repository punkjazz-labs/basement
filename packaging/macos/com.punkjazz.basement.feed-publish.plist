<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template only. Render machine-local paths using docs/RECIPE-FEED.md
     section 6 before loading it. launchd does not expand shell variables. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.punkjazz.basement.feed-publish</string>
	<key>ProgramArguments</key>
	<array>
		<string>__REPO_ROOT__/packaging/publish-feed.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO_ROOT__</string>
	<!-- launchd's own default PATH carries none of these, and publish-feed.sh
	     needs go, git and security on it. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__TOOL_PATH__</string>
	</dict>
	<!-- Daily at 10:00. RunAtLoad is false: loading the job (at login, or
	     right after this plist is installed) must not itself trigger a
	     publish; the job runs only on its own schedule. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>10</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>__LOG_PATH__</string>
	<key>StandardErrorPath</key>
	<string>__LOG_PATH__</string>
</dict>
</plist>
